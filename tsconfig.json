{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "vitest.config.js",
    "playwright.config.js",
    "tools/**/*.mjs",
    "test-support/**/*.js",
    "tests/**/*.js"
  ],
  "exclude": [
    "*.user.js",
    "worker.js",
    "node_modules",
    "coverage",
    "playwright-report",
    "test-results"
  ]
}
